#include <dt-bindings/led/led.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

&led_strip { chain-length = <27>; };

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BSPC |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            bindings = <
&kp TAB    &kp COMMA  &kp PERIOD  &kp P     &kp Y   &kp F        &kp G    &kp C   &kp R    &kp L  &kp COLON  &kp BSPC
&kp LCTRL  &kp A      &kp O       &kp E     &kp U   &kp I        &kp D    &kp H   &kp T    &kp N  &kp S      &kp CAPSLOCK
&kp LSHFT  &kp SQT    &kp Q       &kp J     &kp K   &kp X        &kp B    &kp M   &kp W    &kp V  &kp Z      &kp RALT
                                  &kp LGUI  &tog 1  &kp SPACE    &kp RET  &tog 2  &kp ESC
            >;
        };

        lower_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BSPC |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&kp TAB    &kp PERIOD  &kp LC(A)        &kp K_COPY  &kp K_PASTE  &kp K_UNDO    &kp PLUS   &kp N7        &kp N8        &kp N9        &kp ASTERISK  &kp BSPC
&kp LCTRL  &kp LC(L)   &kp LC(S)        &kp K_CUT   &kp UP       &kp K_REDO    &kp MINUS  &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp SLASH     &bt BT_SEL 0
&kp LSHFT  &bt BT_CLR  &kp PRINTSCREEN  &kp DOWN    &kp DOWN     &kp RIGHT     &kp N0     &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp EQUAL     &bt BT_SEL 1
                                        &kp LGUI    &tog 0       &kp SPACE     &kp RET    &trans        &kp RALT
            >;
        };

        raise_layer {
            // -----------------------------------------------------------------------------------------
            // |rgb tog|  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BSPC |
            // | CTRL |RGB BRI+ |RGB SAT+ |RGB HUE+ |RGB ANI+ |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |RGB BRI- |RGB SAT- |RGB HUE- |RGB ANI- |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&rgb_ug RGB_TOG  &kp EXCL         &kp AT           &kp HASH         &kp DLLR         &kp PRCNT    &kp PLUS   &kp AMPS   &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp ASTERISK  &kp BSPC
&kp LCTRL        &rgb_ug RGB_BRI  &rgb_ug RGB_SAI  &rgb_ug RGB_HUI  &rgb_ug RGB_EFF  &trans       &kp MINUS  &kp PIPE   &kp LBKT              &kp RBKT               &kp BSLH      &kp GRAVE
&kp LSHFT        &rgb_ug RGB_BRD  &rgb_ug RGB_SAD  &rgb_ug RGB_HUD  &rgb_ug RGB_EFR  &trans       &kp UNDER  &kp CARET  &kp LBRC              &kp RBRC               &kp EQUAL     &kp TILDE
                                                   &kp LGUI         &tog 3           &kp SPACE    &kp RET    &tog 0     &kp RALT
            >;
        };

        layer_3 {
            bindings = <
&kp F1                &kp F2  &kp F3           &kp F4             &kp F5      &kp F6    &kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12
&kp C_BRIGHTNESS_INC  &trans  &kp C_VOLUME_UP  &kp C_VOLUME_DOWN  &kp C_MUTE  &trans    &trans  &trans  &trans  &trans   &trans   &trans
&kp C_BRIGHTNESS_DEC  &trans  &kp C_PREVIOUS   &kp C_PLAY_PAUSE   &kp C_NEXT  &trans    &trans  &trans  &trans  &trans   &trans   &trans
                                               &kp LGUI           &tog 0      &trans    &trans  &trans  &trans
            >;
        };
    };
};
